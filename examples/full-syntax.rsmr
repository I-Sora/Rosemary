// ROSEMARY の全基本構文を含む仕様確認用サンプル

"第一幕"[act]{
    "主人公が事件に巻き込まれる"

    "第一章"[chapter]{
        "物語の導入"

        "雨の日の再会"[scene, chapter=1, pov="佐倉ミオ", place="駅", status="draft"][#再会 #雨]{
            "ミオと蓮が十年ぶりに駅で再会する"

            summary: [
                ミオと蓮が十年ぶりに駅で再会する。
                - "ミオが駅に到着する" ^ 動作は短く
                    - "改札を抜ける"
                    - "傘を閉じる"
                - "蓮がミオに気づく"
                - "古い鍵が落ちる"
                1. "再会"
                    1. "沈黙"
                    2. "確認"
                2. "沈黙" ^ 余白を作る
                3. "鍵の発見"
                ^ この要約は初稿用の注釈
                古い鍵はこの時点では意味を明かさない。
            ]

            ^ 雨音を強めに描写する
            ミオ >久しぶり ^ 小さな声
            蓮> ……本当に、ミオなのか

            @ "古い鍵" --"発見"-->
            @ "高瀬蓮"[relation, type="幼なじみ", trust=2, at="第一章"] --"警戒"-->
        }
    }
}


"佐倉ミオ"[character][#主人公]{
    age: 17
    personality: "慎重"
    goal: "父の失踪の真相を知る"
    weakness: "他人を信用できない"

    "第一章時点"[state, at="第一章"]{
        personality: "他人を信用しない"
        goal: "父の手がかりを探す"
    }

    "第四章時点"[state, at="第四章"]{
        personality: "蓮だけは信用し始めている"
        goal: "父を追っていた組織の正体を暴く"
    }

    @ "高瀬蓮"[relation, type="協力者", trust=7, at="第四章"] <--"共闘"-->
}

"高瀬蓮"[character][#幼なじみ]{
    age: 18
    personality: "穏やか"
    goal: "ミオを守る"
}

"古い鍵"[item][#伏線 #未回収 #父親]{
    "父の遺品。第三章で意味が判明する"

    ? なぜ父はこれを残したのか
    ! 地下室を開ける鍵だった

    @ "地下室の真相" -."伏線"-.-> 
}

"地下室の真相"[info][#回収]{
    "父が隠していた研究資料が見つかる"

    @ "犯人の動機" =="核心"==>
}

"犯人の動機"[unknown]{
    "まだ未定"
}

"ミオと蓮の関係"[relationship, from="佐倉ミオ", to="高瀬蓮"]{
    "第一章時点"[state, at="第一章"]{
        type: "幼なじみ"
        trust: 2
        emotion: "不信"
    }

    "第三章時点"[state, at="第三章"]{
        type: "協力者"
        trust: 5
        emotion: 共闘
        説明:[
            これはテストの文章です
            - テスト
            - テスト
            1. テスト
            2. テスト
        

        ]
    }

    "終章時点"[state, at="終章"]{
        type: "大切な人"
        trust: 9
        emotion: "信頼"

    }
}
